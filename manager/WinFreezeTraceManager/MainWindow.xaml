<Window
    x:Class="WinFreezeTraceManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Shown only when the window material is "Solid"; otherwise the backdrop (Acrylic / Mica) shows through. -->
        <Border x:Name="SolidLayer" Grid.RowSpan="2" Visibility="Collapsed"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />

        <!-- Title bar merged into the window, like other Windows 11 apps. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="16" Height="16" />
                <TextBlock Text="WinFreezeTrace Manager" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Auto"
                        OpenPaneLength="240"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Icon="Home" Tag="dashboard" />
                <NavigationViewItem Content="Reports" Icon="Document" Tag="reports" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About" Icon="Help" Tag="about" />
            </NavigationView.FooterMenuItems>

            <!-- Recorder state, visible from every page. -->
            <NavigationView.PaneFooter>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,6,12,10"
                            ToolTipService.ToolTip="Current state of the recorder">
                    <Ellipse x:Name="PaneDot" Width="10" Height="10" VerticalAlignment="Center" />
                    <TextBlock x:Name="PaneStatusText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
