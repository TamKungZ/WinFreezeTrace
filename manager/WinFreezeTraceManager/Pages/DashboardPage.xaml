<Page
    x:Class="WinFreezeTraceManager.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,16,32,32" Spacing="12" MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

            <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Error" />

            <InfoBar x:Name="CoreMissing" IsOpen="False" IsClosable="False" Severity="Warning"
                     Title="The recorder program was not found"
                     Message="WinFreezeTrace.exe (with WinFreezeTraceCore.dll beside it) could not be located, so nothing can be recorded. Reinstall WinFreezeTrace or tell the Manager where it is.">
                <InfoBar.ActionButton>
                    <Button Content="Open Settings" Click="OpenSettings_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="FailureBar" IsOpen="False" IsClosable="False" Severity="Warning"
                     Title="Some reports could not be saved">
                <InfoBar.ActionButton>
                    <Button Content="Open recorder log" Click="OpenRecorderLog_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Status: one answer to "is it working?", and the one thing to do about it. -->
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="StatusBadge" Width="56" Height="56" CornerRadius="28" VerticalAlignment="Top">
                        <FontIcon x:Name="StatusGlyph" FontSize="26" Foreground="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="StatusTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="Checking the recorder..." />
                        <TextBlock x:Name="StatusDetail" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                            <Button x:Name="PowerButton" Style="{StaticResource AccentButtonStyle}" Content="..." Click="Power_Click" />
                            <Button x:Name="CaptureButton" Click="Capture_Click"
                                    ToolTipService.ToolTip="Saves a report of what the PC is doing right now. Hotkey: Ctrl+Alt+F12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE722;" FontSize="14" />
                                    <TextBlock Text="Capture report now" />
                                </StackPanel>
                            </Button>
                            <DropDownButton x:Name="MoreButton" Content="More"
                                            AutomationProperties.Name="More recorder actions">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem x:Name="StopItem" Text="Stop the recorder completely" Click="Stop_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE71A;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                        <TextBlock x:Name="CaptureHint" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Three numbers at a glance. -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="SavedCount" Style="{StaticResource TitleTextBlockStyle}" Text="-" />
                        <TextBlock Text="Reports saved" />
                        <TextBlock Text="since the recorder started" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="FailedCount" Style="{StaticResource TitleTextBlockStyle}" Text="-" />
                        <TextBlock Text="Could not be saved" />
                        <TextBlock Text="since the recorder started" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="HotkeyState" Style="{StaticResource TitleTextBlockStyle}" Text="-" />
                        <TextBlock Text="Ctrl+Alt+F12" />
                        <TextBlock x:Name="HotkeyHint" Text="captures a report on demand" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Latest report" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="LastTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="No reports yet" />
                    <TextBlock x:Name="LastPath" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource Hint}" />
                    <TextBlock x:Name="LastHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="When Windows freezes or an app stops responding, a report is saved here automatically. Open summary.txt first: it explains what was going on." />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="OpenLastSummaryButton" Content="Read summary" Click="OpenLastSummary_Click" />
                        <Button x:Name="OpenLastFolderButton" Content="Show in folder" Click="OpenLastFolder_Click" />
                        <HyperlinkButton Content="All reports" Click="AllReports_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
