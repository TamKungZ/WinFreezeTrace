<Page
    x:Class="WinFreezeTraceManager.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="920" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Informational" />

            <!-- Manager -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Manager" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch x:Name="StartupSwitch" Header="Start with Windows" OnContent="On" OffContent="Off" Toggled="Startup_Toggled" />
                    <TextBlock Text="Adds WinFreezeTrace Manager to Settings > Apps > Startup. It starts hidden in the tray and then starts the recorder."
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToggleSwitch x:Name="AutoStartSwitch" Header="Start the recorder when the Manager starts" OnContent="On" OffContent="Off" Toggled="General_Toggled" />
                    <ToggleSwitch x:Name="CloseToTraySwitch" Header="Closing the window keeps the Manager in the tray" OnContent="On" OffContent="Off" Toggled="General_Toggled" />
                    <ToggleSwitch x:Name="NotifySwitch" Header="Notify me when a report is saved" OnContent="On" OffContent="Off" Toggled="General_Toggled" />
                    <ToggleSwitch x:Name="StopOnExitSwitch" Header="Stop the recorder when the Manager exits" OnContent="On" OffContent="Off" Toggled="General_Toggled" />
                    <TextBlock Text="Off (recommended): exiting the Manager leaves the recorder running, so a freeze can still be captured."
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Recorder -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Recorder" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="These options are passed to the recorder when the Manager starts it. A running recorder picks them up after Save and restart."
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <TextBlock Text="Sampling and triggers" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <NumberBox x:Name="IntervalBox" Header="Sampling interval (ms)" Minimum="250" Maximum="60000" SmallChange="250" SpinButtonPlacementMode="Inline" Width="280" HorizontalAlignment="Left" />
                    <NumberBox x:Name="HistoryBox" Header="History kept in memory (seconds)" Minimum="30" Maximum="600" SmallChange="30" SpinButtonPlacementMode="Inline" Width="280" HorizontalAlignment="Left" />
                    <NumberBox x:Name="StallBox" Header="Watchdog lateness that triggers a capture (ms)" Minimum="500" Maximum="30000" SmallChange="100" SpinButtonPlacementMode="Inline" Width="280" HorizontalAlignment="Left" />
                    <NumberBox x:Name="HangTimeoutBox" Header="Foreground window probe timeout (ms)" Minimum="50" Maximum="5000" SmallChange="50" SpinButtonPlacementMode="Inline" Width="280" HorizontalAlignment="Left" />
                    <NumberBox x:Name="HangSamplesBox" Header="Failed probes in a row" Minimum="2" Maximum="20" SmallChange="1" SpinButtonPlacementMode="Inline" Width="280" HorizontalAlignment="Left" />
                    <NumberBox x:Name="CooldownBox" Header="Gap between automatic captures (seconds)" Minimum="5" Maximum="86400" SmallChange="5" SpinButtonPlacementMode="Inline" Width="280" HorizontalAlignment="Left" />
                    <ToggleSwitch x:Name="HotkeySwitch" Header="Ctrl+Alt+F12 forces a capture" OnContent="On" OffContent="Off" />

                    <TextBlock Text="Reports" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <NumberBox x:Name="LeadBox" Header="Lead-in window used by the analysis (seconds)" Minimum="5" Maximum="300" SmallChange="5" SpinButtonPlacementMode="Inline" Width="280" HorizontalAlignment="Left" />
                    <NumberBox x:Name="MaxReportsBox" Header="Keep the newest reports (0 = unlimited)" Minimum="0" Maximum="5000" SmallChange="10" SpinButtonPlacementMode="Inline" Width="280" HorizontalAlignment="Left" />
                    <ToggleSwitch x:Name="DumpSwitch" Header="Write target.dmp (suspends the frozen app briefly)" OnContent="On" OffContent="Off" />
                    <NumberBox x:Name="MinFreeBox" Header="Skip the dump below this much free space (MB, 0 = off)" Minimum="0" Maximum="1048576" SmallChange="256" SpinButtonPlacementMode="Inline" Width="280" HorizontalAlignment="Left" />
                    <NumberBox x:Name="DumpTimeoutBox" Header="Abort a dump that takes longer than (ms)" Minimum="1000" Maximum="120000" SmallChange="1000" SpinButtonPlacementMode="Inline" Width="280" HorizontalAlignment="Left" />
                    <ToggleSwitch x:Name="RedactSwitch" Header="Redact user and computer names, serial numbers, window titles" OnContent="On" OffContent="Off" />
                    <TextBlock Text="Redaction does not cover target.dmp. Turn the dump off before sharing reports."
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <TextBox x:Name="ReportDirBox" Header="Report folder (empty = %LOCALAPPDATA%\WinFreezeTrace\reports)" Width="560" HorizontalAlignment="Left" />
                    <Button Content="Browse..." Click="Browse_Click" />

                    <TextBlock Text="Recorder program" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <TextBox x:Name="CoreExeBox" Header="WinFreezeTrace.exe location (empty = find it automatically)" Width="560" HorizontalAlignment="Left" />
                    <TextBlock x:Name="CoreFound" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="SaveRestartButton" Style="{StaticResource AccentButtonStyle}" Content="Save and restart the recorder" Click="SaveRestart_Click" />
                        <Button Content="Save only" Click="Save_Click" />
                        <Button Content="Reset to defaults" Click="Reset_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
