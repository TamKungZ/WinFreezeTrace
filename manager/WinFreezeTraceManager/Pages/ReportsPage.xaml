<Page
    x:Class="WinFreezeTraceManager.Pages.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32,16,32,24" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Reports" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="Subtitle" Style="{StaticResource Hint}" IsTextSelectionEnabled="True" />
        </StackPanel>

        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False" HorizontalAlignment="Left">
            <AppBarButton x:Name="OpenSummaryButton" Icon="OpenFile" Label="Read summary" Click="OpenSummary_Click" IsEnabled="False"
                          ToolTipService.ToolTip="Open summary.txt of the selected report" />
            <AppBarButton x:Name="OpenFolderButton" Icon="Folder" Label="Show in folder" Click="OpenFolder_Click" IsEnabled="False"
                          ToolTipService.ToolTip="Open the selected report's folder in File Explorer" />
            <AppBarButton x:Name="DeleteButton" Icon="Delete" Label="Delete" Click="Delete_Click" IsEnabled="False"
                          ToolTipService.ToolTip="Delete the selected report (Del)" />
            <AppBarSeparator />
            <AppBarButton Icon="Refresh" Label="Refresh" Click="Refresh_Click" ToolTipService.ToolTip="Reload the list (F5)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Icon="OpenLocal" Label="Reports folder" Click="OpenRoot_Click"
                          ToolTipService.ToolTip="Open the folder that holds all reports" />
        </CommandBar>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="4">
                <Grid>
                    <ListView x:Name="List" SelectionMode="Single" SelectionChanged="List_SelectionChanged" KeyDown="List_KeyDown"
                              AutomationProperties.Name="Saved reports, newest first" />
                    <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" Spacing="6" Padding="16"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8A5;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="No reports yet" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="A report is saved automatically when Windows freezes or an app stops responding."
                                   Style="{StaticResource Hint}" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PreviewTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
                        <Grid>
                            <TextBlock x:Name="PreviewHint" Text="Select a report on the left to read its summary."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0" />
                            <TextBlock x:Name="Preview" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Visibility="Collapsed" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
